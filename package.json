{
  "name": "@upgradeshop/cart",
  "version": "1.4.1",
  "description": "ID-only cart state management with live price fetching for Upgrade Shop customer websites",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./checkout": {
      "import": {
        "types": "./dist/checkout/index.d.mts",
        "default": "./dist/checkout/index.mjs"
      },
      "require": {
        "types": "./dist/checkout/index.d.ts",
        "default": "./dist/checkout/index.js"
      }
    },
    "./checkout/pay-frame": {
      "import": {
        "types": "./dist/checkout/pay-frame.d.mts",
        "default": "./dist/checkout/pay-frame.mjs"
      },
      "require": {
        "types": "./dist/checkout/pay-frame.d.ts",
        "default": "./dist/checkout/pay-frame.js"
      }
    },
    "./checkout/server": {
      "import": {
        "types": "./dist/checkout/server.d.mts",
        "default": "./dist/checkout/server.mjs"
      },
      "require": {
        "types": "./dist/checkout/server.d.ts",
        "default": "./dist/checkout/server.js"
      }
    },
    "./tracking": {
      "import": {
        "types": "./dist/tracking/index.d.mts",
        "default": "./dist/tracking/index.mjs"
      },
      "require": {
        "types": "./dist/tracking/index.d.ts",
        "default": "./dist/tracking/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "license": "UNLICENSED"
}
