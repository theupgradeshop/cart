{
  "cases": [
    {
      "name": "tiered_by_count: qualifying, picks highest tier <= size",
      "rules": [
        {
          "id": "r-tiered-1",
          "minItems": 2,
          "maxItems": 6,
          "eligibleCourseIds": "all",
          "scheme": "tiered_by_count",
          "tiers": [
            {
              "count": 2,
              "percentOff": 10
            },
            {
              "count": 4,
              "percentOff": 20
            },
            {
              "count": 6,
              "percentOff": 30
            }
          ]
        }
      ],
      "chosenCourses": [
        {
          "id": "c1",
          "listPriceMinor": 10000,
          "owned": false
        },
        {
          "id": "c2",
          "listPriceMinor": 12000,
          "owned": false
        },
        {
          "id": "c3",
          "listPriceMinor": 9000,
          "owned": false
        }
      ],
      "expected": {
        "totalMinor": 27900,
        "discountMinor": 3100,
        "appliedRuleId": "r-tiered-1",
        "suppressed": false
      }
    },
